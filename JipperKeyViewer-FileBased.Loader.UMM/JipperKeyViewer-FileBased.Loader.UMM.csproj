<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>JipperKeyViewer.Loader</RootNamespace>
    <AssemblyName>JipperKeyViewer-FileBased.Loader.UMM</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 手写 Properties\AssemblyInfo.cs 保持为程序集特性与版本号的唯一来源
         （SetVersion.ps1 继续改它），屏蔽 SDK 的自动生成 /
         Hand-written Properties\AssemblyInfo.cs stays the single source of assembly
         attributes and versions (SetVersion.ps1 keeps patching it) — disable SDK generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CI 直接从 bin\Release\ 拷贝 DLL：保持经典输出路径，不加 TFM 子目录 /
         CI copies DLLs straight from bin\Release\ — keep the classic output path,
         no TFM segment appended. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- 允许在未安装 .NET Framework 4.8.1 Developer Pack 的机器上编译 /
       Lets the project compile without a local .NET Framework 4.8.1 Developer Pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏与加载器引用 DLL，仅编译期使用，不拷入输出 /
       Game & loader reference DLLs, compile-time only — never copied to output. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>..\libs\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JipperKeyViewer-FileBased\JipperKeyViewer-FileBased.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 与 AssetBundle 版共享同一份入口源码，仅核心 DLL 引用不同 /
       Shares the same entry source with the AssetBundle variant; only the core
       project reference differs. -->
  <ItemGroup>
    <Compile Include="..\JipperKeyViewer.Loader.UMM\UmmEntry.cs" Link="UmmEntry.cs" />
  </ItemGroup>

</Project>
