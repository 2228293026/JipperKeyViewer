<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <!-- 命名空间沿用核心工程的 JipperKeyViewer（源码全部链接自该工程） /
         Namespace follows the core project (all shared sources are linked from it). -->
    <RootNamespace>JipperKeyViewer</RootNamespace>
    <AssemblyName>JipperKeyViewer-FileBased</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 手写 Properties\AssemblyInfo.cs 保持为程序集特性与版本号的唯一来源
         （SetVersion.ps1 继续改它），屏蔽 SDK 的自动生成 /
         Hand-written Properties\AssemblyInfo.cs stays the single source of assembly
         attributes and versions (SetVersion.ps1 keeps patching it) — disable SDK generation. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CI 直接从 bin\Release\ 拷贝 DLL：保持经典输出路径，不加 TFM 子目录 /
         CI copies DLLs straight from bin\Release\ — keep the classic output path,
         no TFM segment appended. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- 允许在未安装 .NET Framework 4.8.1 Developer Pack 的机器上编译 /
       Lets the project compile without a local .NET Framework 4.8.1 Developer Pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏引用 DLL，仅编译期使用，不拷入输出 /
       Game reference DLLs, compile-time only — never copied to output. -->
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\libs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>..\libs\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>..\libs\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>..\libs\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\libs\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\libs\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\libs\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带 Newtonsoft：自定义布局的节点/图层组列表用它持久化（运行时 JsonUtility 会
         丢弃类数组字段）。游戏在 Managed 目录自带该 DLL，运行时可直接解析。 /
         The game ships Newtonsoft: the custom layout node/group lists persist through it
         (the runtime JsonUtility drops class-array fields). Resolvable at runtime from the
         game's own Managed directory. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\libs\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 链接核心工程的全部共享源码；仅 KeyViewerResources.cs 例外——本工程在
       KeyViewer\ 下有自己的文件版实现（通配须显式排除以防类型重复）。
       Links every shared source from the core project; only KeyViewerResources.cs is
       excluded — this project carries its own file-based implementation under KeyViewer\
       (explicit exclude keeps the wildcard from double-defining the type). -->
  <ItemGroup>
    <Compile Include="..\JipperKeyViewer\KeyViewer\**\*.cs" Exclude="..\JipperKeyViewer\KeyViewer\Loader\KeyViewerResources.cs" Link="KeyViewer\%(RecursiveDir)%(FileName)%(Extension)" />
    <Compile Include="..\JipperKeyViewer\Main.cs" Link="Main.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- TGT compat shim: build order only (no compile reference); the resulting assembly is
         embedded below and Assembly.Load-ed at mod init. / TGT 兼容垫片：仅构建顺序（无编译引
         用）；产物在下方内嵌，mod 初始化时 Assembly.Load。 -->
    <ProjectReference Include="..\TgtCompat\KeyViewer.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="..\TgtCompat\bin\Release\KeyViewer.dll">
      <LogicalName>JipperKeyViewer.TgtCompat.KeyViewer.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
